{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOTRO Turkish patch release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patch_version", "release_tag", "release_id", "asset_id", "asset_name", "asset_size", "asset_sha256", "source_dat_sha256", "source_dat_size", "game_version", "asset_kind"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "patch_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "patch_mode": {"type": ["string", "null"], "enum": ["full", "incremental", null]},
    "release_tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "release_id": {"type": "integer", "minimum": 1},
    "asset_id": {"type": "integer", "minimum": 1},
    "asset_name": {"type": "string", "pattern": "^lotro-turkce-yama-[A-Za-z0-9][A-Za-z0-9._-]{0,110}$"},
    "asset_size": {"type": "integer", "minimum": 1},
    "asset_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_dat_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_dat_size": {"type": "integer", "minimum": 1},
    "game_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "candidate_catalog_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "candidate_dat_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "candidate_dat_size": {"type": ["integer", "null"], "minimum": 0},
    "asset_kind": {"type": "string", "enum": ["full_dat", "semantic_delta_patch"]},
    "source_catalog_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "base_patch_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "base_release_tag": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "base_release_id": {"type": ["integer", "null"], "minimum": 0},
    "base_asset_id": {"type": ["integer", "null"], "minimum": 0},
    "base_asset_name": {"type": ["string", "null"], "pattern": "^lotro-turkce-yama-[A-Za-z0-9][A-Za-z0-9._-]{0,110}$"},
    "base_asset_size": {"type": ["integer", "null"], "minimum": 0},
    "base_asset_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "base_candidate_dat_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "base_candidate_dat_size": {"type": ["integer", "null"], "minimum": 0},
    "base_candidate_catalog_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "chain_depth": {"type": ["integer", "null"], "minimum": 0, "maximum": 32},
    "translation_catalog_version": {"type": ["string", "null"], "maxLength": 120},
    "patch_generator_version": {"type": ["string", "null"], "maxLength": 120},
    "translation_provider": {"type": ["string", "null"], "maxLength": 80},
    "translation_model_version": {"type": ["string", "null"], "maxLength": 160},
    "safe_translated_count": {"type": "integer", "minimum": 0},
    "skipped_changed_count": {"type": "integer", "minimum": 0},
    "critical_review_required_count": {"type": "integer", "const": 0},
    "minimum_updater_version": {"type": ["string", "null"], "maxLength": 40, "pattern": "^(?:[0-9]+(?:\\.[0-9]+){1,3})?$"}
  },
  "allOf": [
    {
      "if": {"required": ["asset_kind"], "properties": {"asset_kind": {"const": "semantic_delta_patch"}}},
      "then": {
        "required": ["source_catalog_sha256", "candidate_catalog_sha256", "safe_translated_count", "skipped_changed_count", "critical_review_required_count"],
        "properties": {
          "source_catalog_sha256": {"type": "string"},
          "candidate_catalog_sha256": {"type": "string"}
        }
      }
    },
    {
      "if": {"required": ["candidate_dat_sha256"], "properties": {"candidate_dat_sha256": {"type": "string"}}},
      "then": {
        "required": ["candidate_dat_size"],
        "properties": {"candidate_dat_size": {"type": "integer", "minimum": 1}}
      }
    },
    {
      "if": {"required": ["patch_mode"], "properties": {"patch_mode": {"const": "incremental"}}},
      "then": {
        "required": ["base_patch_version", "base_release_tag", "base_release_id", "base_asset_id", "base_asset_name", "base_asset_size", "base_asset_sha256", "base_candidate_dat_sha256", "base_candidate_dat_size", "base_candidate_catalog_sha256", "candidate_dat_sha256", "candidate_dat_size", "chain_depth"],
        "properties": {
          "asset_kind": {"const": "semantic_delta_patch"},
          "base_patch_version": {"type": "string"},
          "base_release_tag": {"type": "string"},
          "base_release_id": {"type": "integer", "minimum": 1},
          "base_asset_id": {"type": "integer", "minimum": 1},
          "base_asset_name": {"type": "string"},
          "base_asset_size": {"type": "integer", "minimum": 1},
          "base_asset_sha256": {"type": "string"},
          "base_candidate_dat_sha256": {"type": "string"},
          "base_candidate_dat_size": {"type": "integer", "minimum": 1},
          "base_candidate_catalog_sha256": {"type": "string"},
          "candidate_dat_sha256": {"type": "string"},
          "candidate_dat_size": {"type": "integer", "minimum": 1},
          "chain_depth": {"type": "integer", "minimum": 1}
        }
      }
    }
  ]
}
