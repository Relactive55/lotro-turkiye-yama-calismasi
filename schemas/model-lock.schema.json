{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOTRO translation model lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "model_id", "verified"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider": {"type": "string", "enum": ["OPUS", "ARGOS", "OTHER"]},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": ["string", "null"], "maxLength": 200},
    "download_size_bytes": {"type": ["integer", "null"], "minimum": 1},
    "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "verified": {"type": "boolean"}
  }
}
